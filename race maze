                pygame.mixer.init(frequency=22050, size=-16, channels=2, buffer=512)
        except pygame.error:
            pass
        self.sfx_coin = synth_sound([780, 1040, 1360], 0.17)
        self.sfx_unlock = synth_sound([440, 660, 880, 1170], 0.36)
        self.sfx_victory = synth_sound([523, 659, 784, 1046], 0.55)
        self.sfx_wall = synth_sound([145, 115], 0.075, 0.08)
        self.update_layout(*self.screen.get_size())
        self.new_level(reset_level_number=False)
        self.state = "garage"

    # acomoda la ventana cuando cambia de tamaño
    def update_layout(self, width: int, height: int) -> None:
        width = max(960, width)
        height = max(650, height)
        if self.fullscreen:
            self.screen = pygame.display.set_mode((width, height), pygame.FULLSCREEN)
        else:
            self.screen = pygame.display.set_mode((width, height), pygame.RESIZABLE)

        usable_y = height - self.hud_height - self.bottom_margin - self.margin_y
        usable_x = width - self.margin_x * 2
        self.arena = pygame.Rect(self.margin_x, self.hud_height + self.margin_y, usable_x, usable_y)
        self.help_rect = pygame.Rect(width - 72, height - 72, 44, 44)
        self.rebuild_cached_sprites()

    # cambia entre pantalla normal y completa
    def toggle_fullscreen(self) -> None:
        self.fullscreen = not self.fullscreen
        if self.fullscreen:
            display = pygame.display.get_desktop_sizes()[0]
            self.update_layout(*display)
        else:
            self.update_layout(*WINDOWED_SIZE)
        self.build_level_geometry()

    # actualiza el tamaño de las llantas y monedas
    def rebuild_cached_sprites(self) -> None:
        self.tire_sprite = build_tire_sprite(max(14, self.tile_size - 2))
        self.coin_sprite = build_coin_sprite(max(14, self.tile_size - 4))

    # crea el nivel, las monedas, la meta y el inicio
    def build_level_geometry(self) -> None:
        inner_margin = max(20, self.arena.width // 32)
        max_grid_width = self.arena.width - inner_margin * 2
        max_grid_height = self.arena.height - inner_margin * 2

        cols_limit = odd(max_grid_width // 23)
        rows_limit = odd(max_grid_height // 23)
        cols_limit = max(27, cols_limit)
        rows_limit = max(19, rows_limit)

        cols, rows = maze_dimensions(self.level, cols_limit, rows_limit)
        self.tile_size = min(max_grid_width // cols, max_grid_height // rows)
        self.tile_size = max(14, min(32, self.tile_size))
        self.rebuild_cached_sprites()

        self.cols = cols
        self.rows = rows
        self.grid = generate_maze(cols, rows)
        self.start_cell = (1, rows - 2)
        self.goal_cell = choose_goal(self.grid, self.start_cell)
        self.path_to_goal = bfs(self.grid, self.start_cell, self.goal_cell)
        if not self.path_to_goal:
            self.grid = generate_maze(cols, rows)
            self.goal_cell = choose_goal(self.grid, self.start_cell)
            self.path_to_goal = bfs(self.grid, self.start_cell, self.goal_cell)

        self.coin_total = min(3 + (self.level - 1) // 2, 8)
        self.coins = choose_coins(self.grid, self.start_cell, self.goal_cell, self.coin_total)
        self.coin_total = len(self.coins)
        self.collected_in_level = 0

        maze_w = self.cols * self.tile_size
        maze_h = self.rows * self.tile_size
        self.maze_rect = rect_from_center(self.arena.center, (maze_w, maze_h))
        self.player_cell = self.start_cell
        self.facing = (0, -1)

    # prepara un nivel desde el principio
    def new_level(self, *, reset_level_number: bool = False) -> None:
        if reset_level_number:
            self.level = 1
        self.build_level_geometry()
        self.show_hint = False
        self.state = "garage"
        self.notice = ""
        self.notice_until = 0
        self.elapsed_when_stopped = 0.0
        self.started_at = pygame.time.get_ticks()

    # inicia o continua la carrera
    def start_or_resume_level(self) -> None:
        self.started_at = pygame.time.get_ticks() - int(self.elapsed_when_stopped * 1000)
        self.state = "playing"

    # pasa al siguiente nivel
    def next_level(self) -> None:
        self.level += 1
        self.total_coins_collected += self.collected_in_level
        self.build_level_geometry()
        self.elapsed_when_stopped = 0.0
        self.started_at = pygame.time.get_ticks()
        self.state = "playing"

    # calcula el tiempo de la partida
    def current_seconds(self) -> float:
        if self.state == "playing":
            return (pygame.time.get_ticks() - self.started_at) / 1000.0
        return self.elapsed_when_stopped

    # muestra avisos por unos segundos
    def flash(self, message: str, ms: int = 1600) -> None:
        self.notice = message
        self.notice_until = pygame.time.get_ticks() + ms

    # busca el centro de una casilla
    def cell_center(self, cell: tuple[int, int]) -> tuple[int, int]:
        x, y = cell
        return (
            self.maze_rect.x + x * self.tile_size + self.tile_size // 2,
            self.maze_rect.y + y * self.tile_size + self.tile_size // 2,
        )

    # comprueba si una casilla es camino y no pared
    def is_path(self, cell: tuple[int, int]) -> bool:
        x, y = cell
        return 0 <= x < self.cols and 0 <= y < self.rows and self.grid[y][x] == 0

    # obtiene el nombre del carro elegido
    def selected_car_name(self) -> str:
        return CAR_MODELS[self.selected_car_index]

    # obtiene la escuderia seleccionada
    def selected_team(self) -> dict:
        return F1_TEAMS[self.selected_team_index]

    # obtiene los colores de esa escuderia
    def selected_palette(self) -> dict:
        return self.selected_team()["colors"]

    # cambia entre los cuatro carros
    def cycle_avatar(self, step: int) -> None:
        self.selected_car_index = (self.selected_car_index + step) % len(CAR_MODELS)
        self.anim_since = pygame.time.get_ticks()

    # cambia entre los colores de escuderias
    def cycle_team(self, step: int) -> None:
        self.selected_team_index = (self.selected_team_index + step) % len(F1_TEAMS)
        self.anim_since = pygame.time.get_ticks()


    # lee las teclas segun estemos en menu o jugando
    def handle_key(self, key: int) -> None:
        if key == pygame.K_F11:
            self.toggle_fullscreen()
            return

        if self.state == "garage":
            if key == pygame.K_ESCAPE:
                self.running = False
                return
            if key in (pygame.K_UP, pygame.K_w):
                self.cycle_avatar(-1)
                return
            if key in (pygame.K_DOWN, pygame.K_s):
                self.cycle_avatar(1)
                return
            if key in (pygame.K_LEFT, pygame.K_a):
                self.cycle_team(-1)
                return
            if key in (pygame.K_RIGHT, pygame.K_d):
                self.cycle_team(1)
                return
            if key in (pygame.K_RETURN, pygame.K_SPACE):
                self.start_or_resume_level()
                return
            return

        if key == pygame.K_ESCAPE:
            if self.show_controls:
                self.show_controls = False
                return
            if self.state == "playing":
                self.elapsed_when_stopped = self.current_seconds()
                self.state = "paused"
            elif self.state == "paused":
                self.state = "garage"
            return

        if key in (pygame.K_RETURN, pygame.K_SPACE):
            if self.state == "victory":
                self.next_level()
                return

        if self.state == "paused" and key == pygame.K_p:
            self.start_or_resume_level()
            return

        if self.state != "playing":
            return

        if key == pygame.K_p:
            self.elapsed_when_stopped = self.current_seconds()
            self.state = "paused"
            return
        if key == pygame.K_h:
            self.show_hint = not self.show_hint
            return
        if key == pygame.K_r:
            self.build_level_geometry()
            self.started_at = pygame.time.get_ticks()
            self.elapsed_when_stopped = 0.0
            return

        directions = {
            pygame.K_UP: (0, -1),
            pygame.K_w: (0, -1),
            pygame.K_DOWN: (0, 1),
            pygame.K_s: (0, 1),
            pygame.K_LEFT: (-1, 0),
            pygame.K_a: (-1, 0),
            pygame.K_RIGHT: (1, 0),
            pygame.K_d: (1, 0),
        }
        if key in directions:
            self.move_player(*directions[key])

    # revisa los clics en botones y opciones
    def handle_mouse(self, pos: tuple[int, int]) -> None:
        if self.state == "garage":
            for i, rect in enumerate(self.avatar_rects):
                if rect.collidepoint(pos):
                    self.selected_car_index = i
                    self.anim_since = pygame.time.get_ticks()
                    self.garage_focus = 0
                    return
            if self.team_left_rect.collidepoint(pos):
                self.cycle_team(-1)
                self.garage_focus = 1
                return
            if self.team_right_rect.collidepoint(pos):
                self.cycle_team(1)
                self.garage_focus = 1
                return
            if self.start_rect.collidepoint(pos):
                self.start_or_resume_level()
                return
            return

        if self.help_rect.collidepoint(pos):
            self.show_controls = not self.show_controls
        else:
            popup = self.controls_popup_rect()
            if self.show_controls and popup.collidepoint(pos):
                return
            self.show_controls = False

    # mueve el carro, recoge monedas y revisa la meta
    def move_player(self, dx: int, dy: int) -> None:
        target = (self.player_cell[0] + dx, self.player_cell[1] + dy)
        if not self.is_path(target):
            # si hay una pared, no dejamos avanzar al carro
            return
        self.player_cell = target
        self.facing = (dx, dy)

        if target in self.coins:
            # al pasar sobre una moneda, la quitamos del mapa
            self.coins.remove(target)
            self.collected_in_level += 1
            if self.sfx_coin:
                self.sfx_coin.play()
            if self.coins:
                self.flash(f"MONEDA {self.collected_in_level}/{self.coin_total}", 2200)
            else:
                if self.sfx_unlock:
                    self.sfx_unlock.play()
                self.flash("TODAS LAS MONEDAS! SALIDA ABIERTA", 3200)

        if target == self.goal_cell:
            # para ganar necesitamos haber recogido todas las monedas
            if self.coins:
                self.flash(f"META CERRADA: FALTAN {len(self.coins)} MONEDAS", 2400)
            else:
                self.elapsed_when_stopped = self.current_seconds()
                self.state = "victory"
                if self.sfx_victory:
                    self.sfx_victory.play()


