# pone un borde al texto para que se lea mejor
def render_text_with_outline(text: str, font: pygame.font.Font, color, outline=(12, 16, 24), thickness: int = 2) -> pygame.Surface:
    base = font.render(text, True, color)
    surf = pygame.Surface((base.get_width() + thickness * 2, base.get_height() + thickness * 2), pygame.SRCALPHA)
    for ox in range(-thickness, thickness + 1):
        for oy in range(-thickness, thickness + 1):
            if ox == 0 and oy == 0:
                continue
            surf.blit(font.render(text, True, outline), (ox + thickness, oy + thickness))
    surf.blit(base, (thickness, thickness))
    return surf

# SONIDOS DEL JUEGO
# crea sonidos sencillos con diferentes frecuencias
def synth_sound(frequencies, duration=0.18, volume=0.20):
    if not pygame.mixer.get_init():
        return None
    rate, _, channels = pygame.mixer.get_init()
    total = max(1, int(rate * duration))
    values = array('h')
    for i in range(total):
        freq = frequencies[min(len(frequencies)-1, int(i / total * len(frequencies)))]
        wave = 1.0 if math.sin(2 * math.pi * freq * i / rate) >= 0 else -1.0
        envelope = min(1, i / (rate * 0.012)) * max(0.0, 1-i / total)
        value = int(24000 * volume * wave * envelope)
        values.extend([value] * channels)
    try:
        return pygame.mixer.Sound(buffer=values.tobytes())
    except pygame.error:
        return None

