# PANTALLA PRINCIPAL Y LABERINTO
    # decide que pantalla se tiene que dibujar
    def draw(self) -> None:
        if self.state == "garage":
            self.draw_garage()
            pygame.display.flip()
            return
        self.screen.fill(GRASS)
        self.draw_background()
        self.draw_maze()
        self.draw_hud()
        if self.state in {"paused", "victory"}:
            self.draw_overlay()
        self.draw_hamburger()
        if self.show_controls:
            self.draw_controls_popup()
        pygame.display.flip()

    # pinta el fondo y el circuito
    def draw_background(self) -> None:
        w, h = self.screen.get_size()
        for y in range(0, h, 22):
            color = GRASS if (y // 22) % 2 == 0 else GRASS_DARK
            pygame.draw.rect(self.screen, color, (0, y, w, 22))

        pygame.draw.rect(self.screen, HUD_BG, (0, 0, w, self.hud_height))

        outer = self.arena.inflate(16, 16)
        pygame.draw.rect(self.screen, BLACK, outer, border_radius=32)
        pygame.draw.rect(self.screen, SOFT_WHITE, outer.inflate(-6, -6), border_radius=30)
        pygame.draw.rect(self.screen, ASPHALT_DARK, self.arena.inflate(4, 4), border_radius=26)
        pygame.draw.rect(self.screen, ASPHALT, self.arena, border_radius=24)

        dash_w = max(18, self.arena.width // 25)
        dash_h = 4
        top_y = self.arena.y + 18
        bottom_y = self.arena.bottom - 22
        x = self.arena.x + 26
        while x < self.arena.right - 40:
            pygame.draw.rect(self.screen, SOFT_WHITE, (x, top_y, dash_w, dash_h))
            pygame.draw.rect(self.screen, SOFT_WHITE, (x, bottom_y, dash_w, dash_h))
            x += dash_w + 18

    # dibuja paredes, caminos, monedas, meta y carro
    def draw_maze(self) -> None:
        shadow_rect = self.maze_rect.move(5, 5)
        pygame.draw.rect(self.screen, (35, 38, 43), shadow_rect)
        pygame.draw.rect(self.screen, ASPHALT, self.maze_rect)

        for y in range(self.rows):
            for x in range(self.cols):
                cell_rect = pygame.Rect(
                    self.maze_rect.x + x * self.tile_size,
                    self.maze_rect.y + y * self.tile_size,
                    self.tile_size,
                    self.tile_size,
                )
                if self.grid[y][x] == 0:
                    pygame.draw.rect(self.screen, (72, 76, 84), cell_rect)
                else:
                    pygame.draw.rect(self.screen, (9, 13, 20), cell_rect)
                    inner = cell_rect.inflate(-2, -2)
                    pygame.draw.rect(self.screen, (38, 47, 60), inner)
                    pygame.draw.rect(self.screen, (73, 84, 98),
                                     (inner.x + 1, inner.y + 1, inner.width - 2, 3))
                    wheel_size = max(12, self.tile_size - 5)
                    tire = self.tire_sprite
                    self.screen.blit(tire, tire.get_rect(center=cell_rect.center))
                    north_open = y > 0 and self.grid[y - 1][x] == 0
                    south_open = y + 1 < self.rows and self.grid[y + 1][x] == 0
                    west_open = x > 0 and self.grid[y][x - 1] == 0
                    east_open = x + 1 < self.cols and self.grid[y][x + 1] == 0
                    stripe = WHITE if (x + y) % 2 else RED
                    edge = max(2, self.tile_size // 8)
                    if north_open:
                        pygame.draw.rect(self.screen, stripe, (cell_rect.x, cell_rect.y, self.tile_size, edge))
                    if south_open:
                        pygame.draw.rect(self.screen, stripe, (cell_rect.x, cell_rect.bottom - edge, self.tile_size, edge))
                    if west_open:
                        pygame.draw.rect(self.screen, stripe, (cell_rect.x, cell_rect.y, edge, self.tile_size))
                    if east_open:
                        pygame.draw.rect(self.screen, stripe, (cell_rect.right - edge, cell_rect.y, edge, self.tile_size))

        if self.show_hint:
            target = self.goal_cell if not self.coins else min(self.coins, key=lambda c: len(bfs(self.grid, self.player_cell, c)) or 9999)
            hint_path = bfs(self.grid, self.player_cell, target)
            for cell in hint_path[1:-1]:
                cx, cy = self.cell_center(cell)
                size = max(4, self.tile_size // 4)
                pygame.draw.rect(self.screen, CYAN, (cx - size // 2, cy - size // 2, size, size))

        locked = bool(self.coins)
        goal_sprite = build_goal_sprite(max(14, self.tile_size - 4), locked)
        self.screen.blit(goal_sprite, goal_sprite.get_rect(center=self.cell_center(self.goal_cell)))

        for coin in self.coins:
            self.screen.blit(self.coin_sprite, self.coin_sprite.get_rect(center=self.cell_center(coin)))

        player_sprite = build_car_sprite(max(12, int(self.tile_size * 0.58)), self.facing, self.selected_car_index, self.selected_palette())
        self.screen.blit(player_sprite, player_sprite.get_rect(center=self.cell_center(self.player_cell)))

# TEXTOS Y CONTROLES EN PANTALLA
    # muestra el nivel, el tiempo y los avisos
    def draw_hud(self) -> None:
        w = self.screen.get_width()
        title = render_text_with_outline("RACE MAZE", make_title_font(28), WHITE, outline=(7, 12, 22), thickness=2)
        self.screen.blit(title, (16, 8))

        level_text = render_text_with_outline(f"Nivel {self.level}", make_title_font(18), YELLOW, outline=(31, 38, 53), thickness=1)
        secs = int(self.current_seconds())
        time_text = render_text_with_outline(
            f"TIEMPO {secs // 60:02}:{secs % 60:02}", make_title_font(18), WHITE, outline=(31, 38, 53), thickness=1
        )

        self.screen.blit(level_text, level_text.get_rect(center=(w // 2, 18)))
        self.screen.blit(time_text, time_text.get_rect(topright=(w - 16, 10)))


        if self.notice and pygame.time.get_ticks() < self.notice_until and self.state == "playing":
            note_font = make_title_font(17)
            note = note_font.render(self.notice, True, YELLOW)
            pad_x, pad_y = 12, 7
            back = note.get_rect(center=(self.arena.centerx, self.arena.y - 12)).inflate(pad_x * 2, pad_y * 2)
            pygame.draw.rect(self.screen, BLACK, back.move(3, 3), border_radius=7)
            pygame.draw.rect(self.screen, HUD_BG, back, border_radius=7)
            pygame.draw.rect(self.screen, YELLOW, back, 2, border_radius=7)
            self.screen.blit(note, note.get_rect(center=back.center))

    # dibuja el boton de ayuda
    def draw_hamburger(self) -> None:
        box = self.help_rect
        pygame.draw.rect(self.screen, HUD_BG, box.move(3, 3), border_radius=8)
        pygame.draw.rect(self.screen, (24, 39, 61), box, border_radius=8)
        pygame.draw.rect(self.screen, YELLOW, box, 3, border_radius=8)
        q = render_pixel_text("?", WHITE, base_size=17, scale=2)
        self.screen.blit(q, q.get_rect(center=box.center))

    # calcula donde va el cuadro de ayuda
    def controls_popup_rect(self) -> pygame.Rect:
        return pygame.Rect(self.screen.get_width() - 380, self.screen.get_height() - 304, 344, 224)

    # muestra los controles cuando abrimos ayuda
    def draw_controls_popup(self) -> None:
        rect = self.controls_popup_rect()
        pygame.draw.rect(self.screen, BLACK, rect.move(5, 5), border_radius=9)
        pygame.draw.rect(self.screen, HUD_BG, rect, border_radius=9)
        pygame.draw.rect(self.screen, YELLOW, rect, 2, border_radius=9)
        title = render_text_with_outline("CONTROLES", make_title_font(18), YELLOW, outline=(31, 38, 53), thickness=1)
        self.screen.blit(title, (rect.x + 14, rect.y + 10))
        lines = [
            "Flechas / WASD : Mover",
            "Enter / Space : Continuar",
            "H : Ruta de ayuda",
            "P : Pausar / Seguir",
            "R : Reiniciar nivel",
            "F11 : Pantalla completa",
            "ESC : Pausar / Garaje",
        ]
        line_font = make_font(15)
        for index, line in enumerate(lines):
            item = line_font.render(line, True, WHITE)
            self.screen.blit(item, (rect.x + 14, rect.y + 48 + 23 * index))

    # muestra la pausa o pantalla de victoria
    def draw_overlay(self) -> None:
        veil = pygame.Surface(self.screen.get_size(), pygame.SRCALPHA)
        veil.fill(SHADOW)
        self.screen.blit(veil, (0, 0))

        box = rect_from_center(self.screen.get_rect().center, (min(760, self.screen.get_width() - 120), 230))
        pygame.draw.rect(self.screen, HUD_BG, box, border_radius=14)
        pygame.draw.rect(self.screen, WHITE, box, 3, border_radius=14)

        if self.state == "paused":
            heading = "PAUSA"
            lines = [
                "Carrera en PAUSA",
                "P para continuar",
                "ESC para elegir otro auto",
            ]
            colors = [WHITE, YELLOW, SOFT_WHITE]
        else:
            heading = "NIVEL COMPLETADO"
            t = int(self.elapsed_when_stopped)
            lines = [
                f"Nivel {self.level}   Monedas {self.collected_in_level}/{self.coin_total}",
                f"Tiempo {t // 60:02}:{t % 60:02}",
                "ENTER o ESPACIO para el siguiente nivel",
            ]
            colors = [WHITE, GREEN, YELLOW]

        head = render_text_with_outline(heading, make_title_font(28), WHITE, outline=(31, 38, 53), thickness=2)
        self.screen.blit(head, head.get_rect(center=(box.centerx, box.y + 48)))

        body_font = make_font(18)
        y = box.y + 108
        for line, color in zip(lines, colors):
            surf = body_font.render(line, True, color)
            self.screen.blit(surf, surf.get_rect(center=(box.centerx, y)))
            y += 34

# BUCLE PRINCIPAL: AQUI EL JUEGO SE MANTIENE ACTIVO
    # revisa eventos y actualiza el juego cada cuadro
    def run(self) -> None:
        repeat_enabled = False
        pygame.key.set_repeat()
        while self.running:
            self.clock.tick(FPS)
            should_repeat = self.state != "garage"
            # en el laberinto dejamos mantener la tecla; en el menu no
            if should_repeat != repeat_enabled:
                if should_repeat:
                    pygame.key.set_repeat(170, 80)
                else:
                    pygame.key.set_repeat()
                repeat_enabled = should_repeat
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    self.running = False
                elif event.type == pygame.KEYDOWN:
                    self.handle_key(event.key)
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    self.handle_mouse(event.pos)
                elif event.type == pygame.VIDEORESIZE and not self.fullscreen:
                    self.update_layout(event.w, event.h)
                    self.build_level_geometry()

            self.draw()

        pygame.quit()


