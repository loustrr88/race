# MEDIDAS Y CREACION DEL LABERINTO
# hace que una medida sea impar
def odd(n: int) -> int:
    return n if n % 2 == 1 else n - 1


# calcula el tamano del laberinto segun el nivel
def maze_dimensions(level: int, cols_limit: int, rows_limit: int) -> tuple[int, int]:
    start_cols = 27
    start_rows = 19
    cols = min(cols_limit, start_cols + ((level - 1) // 2) * 2)
    rows = min(rows_limit, start_rows + ((level - 1) // 3) * 2)
    return odd(cols), odd(rows)


# crea el laberinto usando DFS y caminos aleatorios
def generate_maze(cols: int, rows: int) -> list[list[int]]:
    grid = [[1 for _ in range(cols)] for _ in range(rows)]
    # al inicio todas las casillas son paredes (1)
    start = (1, rows - 2)
    grid[start[1]][start[0]] = 0
    stack = [start]
    # esta pila guarda por donde vamos pasando en el DFS

    while stack:
        x, y = stack[-1]
        candidates: list[tuple[int, int, int, int]] = []
        for dx, dy in ((2, 0), (-2, 0), (0, 2), (0, -2)):
            nx, ny = x + dx, y + dy
            if 1 <= nx < cols - 1 and 1 <= ny < rows - 1 and grid[ny][nx] == 1:
                candidates.append((nx, ny, dx, dy))
        if candidates:
            nx, ny, dx, dy = random.choice(candidates)
            # elegimos al azar por donde abrir el siguiente camino
            grid[y + dy // 2][x + dx // 2] = 0
            grid[ny][nx] = 0
            stack.append((nx, ny))
        else:
            stack.pop()
            # si no podemos seguir, regresamos un paso

    grid[rows - 2][1] = 0
    grid[1][cols - 2] = 0
    return grid


# BUSQUEDA DE RUTAS CON BFS
# busca la ruta mas corta entre dos puntos
def bfs(grid: list[list[int]], start: tuple[int, int], goal: tuple[int, int]) -> list[tuple[int, int]]:
    queue = deque([start])
    # BFS usa una cola para revisar posiciones cercanas primero
    prev = {start: None}
    while queue:
        node = queue.popleft()
        if node == goal:
            path = []
            while node is not None:
                path.append(node)
                node = prev[node]
            return path[::-1]
        x, y = node
        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            q = (x + dx, y + dy)
            if 0 <= q[1] < len(grid) and 0 <= q[0] < len(grid[0]) and grid[q[1]][q[0]] == 0 and q not in prev:
                prev[q] = node
                queue.append(q)
    return []

# DISTANCIAS, META Y MONEDAS
# calcula que tan lejos esta cada casilla del inicio
def distances_from(grid, start):
    distances = {start: 0}
    queue = deque([start])
    # BFS usa una cola para revisar posiciones cercanas primero
    while queue:
        x, y = queue.popleft()
        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            neighbor = (x + dx, y + dy)
            nx, ny = neighbor
            if (0 <= nx < len(grid[0]) and 0 <= ny < len(grid)
                    and grid[ny][nx] == 0 and neighbor not in distances):
                distances[neighbor] = distances[(x, y)] + 1
                queue.append(neighbor)
    return distances


# elige una meta que quede lejos del inicio
def choose_goal(grid, start):
    distances = distances_from(grid, start)
    cols, rows = len(grid[0]), len(grid)
    edge_cells = [
        (x, y) for (x, y) in distances
        if (x == 1 or x == cols - 2 or y == 1 or y == rows - 2)
        and (x, y) != start
    ]
    farthest = max(distances[cell] for cell in edge_cells)
    candidates = [cell for cell in edge_cells
                  if distances[cell] >= max(5, farthest * 0.70)]
    return random.choice(candidates)


# reparte las monedas por los caminos del laberinto
def choose_coins(grid, start, goal, amount):
    main_route = bfs(grid, start, goal)
    route_index = {cell: i for i, cell in enumerate(main_route)}
    cols, rows = len(grid[0]), len(grid)
    queue = deque(main_route)
    branch_dist = {cell: 0 for cell in main_route}
    anchor = {cell: route_index[cell] for cell in main_route}
    while queue:
        x, y = queue.popleft()
        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nxt = (x + dx, y + dy)
            if (0 <= nxt[0] < cols and 0 <= nxt[1] < rows
                    and grid[nxt[1]][nxt[0]] == 0 and nxt not in branch_dist):
                branch_dist[nxt] = branch_dist[(x, y)] + 1
                anchor[nxt] = anchor[(x, y)]
                queue.append(nxt)

    available = [cell for cell, dist in branch_dist.items()
                 if cell not in (start, goal) and 1 <= dist <= 5]
    selected = set()
    amount = min(amount, max(1, len(branch_dist) - 2))
    for i in range(amount):
        center = (i + 1) * (len(main_route) - 1) / (amount + 1)
        choices = [cell for cell in available if cell not in selected]
        if not choices:
            break
        def score(cell):
            progress = abs(anchor[cell] - center)
            same_branch = sum(abs(anchor[cell] - anchor[c]) < 6 for c in selected)
            preferred_depth = abs(branch_dist[cell] - 3)
            return (progress * 2.5 + same_branch * 30 + preferred_depth * 2
                    + random.random() * 2)
        selected.add(min(choices, key=score))

    if len(selected) < amount:
        for i in range(len(selected), amount):
            center = (i + 1) * (len(main_route) - 1) / (amount + 1)
            possibilities = [c for c in main_route[2:-2] if c not in selected]
            if not possibilities:
                break
            selected.add(min(possibilities, key=lambda c: abs(route_index[c] - center)))
    return selected


